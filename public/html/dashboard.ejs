<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Growtopia - Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<%
    const fieldWrapper = 'flex items-center border-2 border-[#81d4fa] rounded bg-[#2b4d6d] px-1 py-1';
    const fieldInput = 'w-full bg-[#2b4d6d] text-white text-xs placeholder-white focus:outline-none';
-%>
<body class="flex flex-col items-center justify-center h-screen bg-[#e0f7fa]">
    <div class="fixed inset-0 flex items-center justify-center">
        <div class="relative bg-[#2b4d6d] border-4 border-[#87b8cc] shadow-lg p-6 w-80 rounded-lg">
            <p class="text-white text-center font-bold text-2xl">Login</p>
            <div id="errorDiv" class="hidden flex flex-col mt-2 text-xs text-red-700 font-bold px-[5px] bg-[#2b4d6d] rounded">
                <a id="errorMessage"></a>
            </div>
            <form 
            method="post"
            action="/player/growid/login/validate"
            accept-charset="UTF-8"
            id="loginForm" class="mt-3">
                <div class="mb-1">
                    <input name="type" value="log" type="hidden" />
                    <input name="_token" value="<%= JSON.stringify(data) %>" type="hidden" />
                    <label for="loginGrowId" class="block text-white text-xs">GrowID</label>
                    <div class="<%= fieldWrapper %>">
                        <i class="fas fa-user text-white mr-1 text-xs"></i>
                        <input type="text" name="growId" id="loginGrowId" class="<%= fieldInput %>" placeholder="Enter your growid">
                    </div>
                </div>
                <div class="mb-1">
                    <label for="loginPassword" class="block text-white text-xs">Password</label>
                    <div class="<%= fieldWrapper %>">
                        <i class="fas fa-lock text-white mr-1 text-xs"></i>
                        <input type="password" name="password" id="loginPassword" class="<%= fieldInput %>" placeholder="Enter your password">
                        <button type="button" id="toggleLogPassword" class="text-white ml-2 focus:outline-none text-xs">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>
                <div class="flex justify-end items-center">
                    <button id="loginButton" class="px-2 py-1 rounded bg-[#00b8ff] text-white text-xs hover:bg-[#06a4dd] transition duration-300 ease-in-out transform hover:scale-105">Login</button>
                </div>
            </form>
        </div>
    </div>
    <script>
        const el = id => document.getElementById(id);

        const loginForm = el('loginForm');
        const growIdField = el('loginGrowId');
        const passwordField = el('loginPassword');
        const errorDiv = el('errorDiv');
        const errorMessage = el('errorMessage');

        const MIN_CREDENTIAL_LENGTH = 4;

        function showError(message) {
            errorDiv.classList.remove('hidden');
            errorMessage.innerHTML = message;
        }

        function togglePasswordVisibility(field, button) {
            const hidden = field.getAttribute('type') === 'password';
            field.setAttribute('type', hidden ? 'text' : 'password');
            button.innerHTML = `<i class="fas fa-eye${hidden ? '-slash' : ''}"></i>`;
        }

        document.addEventListener('DOMContentLoaded', function () {
            const savedGrowId = localStorage.getItem('growId');
            if (savedGrowId) {
                growIdField.value = savedGrowId;
            }
        });
        el('loginButton').addEventListener('click', function (event) {
            event.preventDefault();

            const uName = growIdField.value;
            const uPass = passwordField.value;

            if (!uName || !uPass) {
                showError('Username or Password is empty');
                return;
            }
            if (uName.length < MIN_CREDENTIAL_LENGTH || uPass.length < MIN_CREDENTIAL_LENGTH) {
                showError(`Username or Password must be at least ${MIN_CREDENTIAL_LENGTH} characters long`);
                return;
            }
            loginForm.submit();
            localStorage.setItem('growId', uName);
        })
        el('toggleLogPassword').addEventListener('click', function () {
            togglePasswordVisibility(passwordField, this);
        });
    </script>
</body>
</html>